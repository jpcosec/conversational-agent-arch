stateDiagram-v2
    [*] --> idle
    idle --> buffering : mensaje_usuario
    idle --> activation : trigger_sintetico_cron [proactividad]
    buffering --> buffering : mensaje_adicional
    buffering --> greeting : timeout_buffer [primera_interaccion]
    buffering --> questioning : timeout_buffer [sesion_activa]
    interrupted --> questioning : mensaje_retoma [inyecta_contexto_retoma]
    greeting --> presentation : saludo_completado
    presentation --> questioning : consulta_usuario
    questioning --> waiting_tool : requiere_api_externa [Ontologizador inyecta ToolAtom]
    waiting_tool --> questioning : json_api_recibido [se_inyecta_como_turno]
    questioning --> breakpoint_miss : contexto_vacio [Conversador admite desconocimiento]
    breakpoint_miss --> questioning : reformulacion
    questioning --> activation : intencion_accion
    activation --> questioning : protocolo_completado
    questioning --> interrupted : inactividad_prolongada